{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.18.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "20.18.0",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "node": "20.18.0",
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
