{
  "expo": {
    "name": "Expense Manager",
    "slug": "expense-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expenseFavicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/expenseFavicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "expense-manager",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umerfarooqlaghari.expensemanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Expense Manager sends notifications when receipts are scanned and expenses are logged."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/expenseFavicon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.umerfarooqlaghari.expensemanager"
    },
    "web": {
      "favicon": "./assets/expenseFavicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/expenseFavicon.png",
          "color": "#8b5cf6"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed540f0a-df81-4350-a716-3e0e9fce77f8"
      }
    },
    "owner": "umer.farooq"
  }
}
